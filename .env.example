# Copy to .env and change the two passwords before the first start.

TZ=Europe/Amsterdam

# === Conquest ===
# Upstream source. Any commit or fork works; this is where dgate is built from.
CONQUEST_REPO=https://github.com/marcelvanherk/Conquest-DICOM-Server.git

# AE title and DICOM port, as seen by your modalities.
CONQUEST_AET=CONQUESTSRV1
CONQUEST_PORT=4006

# Web UI port on the host. 80 works too if nothing else uses it.
HTTP_PORT=8080

# maklinux build option: 1 = MySQL/MariaDB
CONQUEST_MAKLINUX_OPTION=1
CONQUEST_INSTALL_AS_SERVICE=n
# Set to n after the first successful start if you prefer.
CONQUEST_REGENERATE_DATABASE=y

DICOM_DATA_PATH=/data/dicom

# The server's own entry in acrnema.map.
CONQUEST_LOCAL_IP=127.0.0.1
CONQUEST_LOCAL_COMPRESSION=un

# === MariaDB ===
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=conquest
MYSQL_USER=conquest
MYSQL_PASSWORD=change_me_database_password
# Conquest shares the host network namespace, so the database is on loopback.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
